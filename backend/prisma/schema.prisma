// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPER_ADMIN
  WORKER
  OFFICE_STAFF
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ServiceStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkerStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
}

enum StaffStatus {
  AVAILABLE
  OFF_DUTY
}

enum AttendanceStatus {
  PRESENT
  LEAVE
  OFF_DUTY
}

model User {
  id              String            @id @default(uuid())
  name            String?
  email           String?           @unique
  username        String?           @unique
  phone           String?
  avatar          String?
  password        String
  role            Role              @default(CUSTOMER)
  workerStatus    WorkerStatus?     @default(AVAILABLE)
  staffStatus     StaffStatus?      @default(OFF_DUTY)
  isEmailVerified Boolean           @default(false)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  otps                Otp[]
  attendances         Attendance[]
  customerEnquiries   ServiceEnquiry[] @relation("CustomerEnquiries")
  officeEnquiries     ServiceEnquiry[] @relation("OfficeEnquiries")
  workerAssignments   ServiceEnquiry[] @relation("WorkerAssignments")
  createdEnquiries    ServiceEnquiry[] @relation("CreatedEnquiries")

  recordedFinances    FinancialTransaction[] @relation("RecordedFinances")
  verifiedFinances    FinancialTransaction[] @relation("VerifiedFinances")
  workerFinances      FinancialTransaction[] @relation("WorkerFinances")
  auditLogs           AuditLog[]             @relation("UserAuditLogs")

  @@map("users")
}

model Attendance {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String           // YYYY-MM-DD
  status     AttendanceStatus @default(PRESENT)
  checkInAt  DateTime         @default(now())
  checkOutAt DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
  @@map("attendances")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      OtpType  @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, isUsed])
  @@map("otps")
}

model ServiceEnquiry {
  id                  String        @id @default(uuid())
  trackingNumber      String        @unique
  serviceName         String
  customerName        String
  customerEmail       String?
  customerPhone       String

  // Kerala Structured Location Details
  state               String        @default("Kerala")
  district            String        @default("Kasaragod")
  city                String?
  location            String?
  mapUrl              String?
  locationRemarks     String?

  // Schedule & Optional Deadline
  preferredDate       DateTime?
  deadline            DateTime?

  // Creator Attribution Flag
  createdByRole       Role          @default(CUSTOMER)
  createdById         String?
  creator             User?         @relation("CreatedEnquiries", fields: [createdById], references: [id], onDelete: SetNull)

  // Work Execution & Hourly Calculation (e.g. JCB / Equipment Meter)
  isHourlyCalculated  Boolean       @default(false)
  hourlyRate          Float?
  workStartedAt       DateTime?
  workEndedAt         DateTime?
  workDurationMinutes Int?
  workerAcceptance    String?

  message             String
  status              ServiceStatus @default(PENDING)
  notes               String?

  customerId          String?
  customer            User?         @relation("CustomerEnquiries", fields: [customerId], references: [id], onDelete: SetNull)

  officeStaffId       String?
  officeStaff         User?         @relation("OfficeEnquiries", fields: [officeStaffId], references: [id], onDelete: SetNull)

  workerId            String?
  worker              User?         @relation("WorkerAssignments", fields: [workerId], references: [id], onDelete: SetNull)

  financialTransactions FinancialTransaction[]

  assignedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status])
  @@index([trackingNumber])
  @@index([workerId])
  @@index([customerId])
  @@index([district])
  @@index([createdByRole])
  @@map("service_enquiries")
}

model Service {
  id          String   @id @default(uuid())
  serviceId   String   @unique
  name        String
  slug        String   @unique
  category    String?  @default("General")
  description String
  features    String[] @default([])
  icon        String?
  image       String?
  priceRange  String?
  duration    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
  @@index([isActive])
  @@index([category])
  @@map("services")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  // Income categories
  SERVICE_PAYMENT
  ADVANCE_PAYMENT
  MILESTONE_PAYMENT
  FINAL_SETTLEMENT

  // Expense categories
  FUEL_DIESEL
  WORKER_WAGE
  WORKER_BATA
  MATERIAL_PURCHASE
  EQUIPMENT_REPAIR
  OFFICE_EXPENSE
  TRANSPORT_TRAVEL
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

enum FinancialStatus {
  PENDING
  VERIFIED
  REJECTED
}

model FinancialTransaction {
  id                String              @id @default(uuid())
  transactionNumber String              @unique
  type              TransactionType
  category          TransactionCategory
  amount            Float
  date              DateTime
  dateString        String              // YYYY-MM-DD
  paymentMethod     PaymentMethod       @default(CASH)
  status            FinancialStatus     @default(PENDING)
  referenceNumber   String?
  serviceType       String?
  customerName      String?
  vendorName        String?
  notes             String?
  receiptUrl        String?

  enquiryId         String?
  enquiry           ServiceEnquiry?     @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  workerId          String?
  worker            User?               @relation("WorkerFinances", fields: [workerId], references: [id], onDelete: SetNull)

  recordedById      String
  recordedBy        User                @relation("RecordedFinances", fields: [recordedById], references: [id], onDelete: Cascade)

  verifiedById      String?
  verifiedBy        User?               @relation("VerifiedFinances", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([dateString])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([recordedById])
  @@index([enquiryId])
  @@map("financial_transactions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  userEmail  String?
  userRole   Role?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}


