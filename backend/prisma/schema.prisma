// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPER_ADMIN
  WORKER
  OFFICE_STAFF
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ServiceStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkerStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
}

model User {
  id              String        @id @default(uuid())
  name            String?
  email           String?       @unique
  username        String?       @unique
  phone           String?
  password        String
  role            Role          @default(CUSTOMER)
  workerStatus    WorkerStatus? @default(AVAILABLE)
  isEmailVerified Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  otps                Otp[]
  customerEnquiries   ServiceEnquiry[] @relation("CustomerEnquiries")
  officeEnquiries     ServiceEnquiry[] @relation("OfficeEnquiries")
  workerAssignments   ServiceEnquiry[] @relation("WorkerAssignments")

  @@map("users")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      OtpType  @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, isUsed])
  @@map("otps")
}

model ServiceEnquiry {
  id             String        @id @default(uuid())
  trackingNumber String        @unique
  serviceName    String
  customerName   String
  customerEmail  String?
  customerPhone  String
  location       String?
  preferredDate  DateTime?
  message        String
  status         ServiceStatus @default(PENDING)
  notes          String?

  customerId     String?
  customer       User?         @relation("CustomerEnquiries", fields: [customerId], references: [id], onDelete: SetNull)

  officeStaffId  String?
  officeStaff    User?         @relation("OfficeEnquiries", fields: [officeStaffId], references: [id], onDelete: SetNull)

  workerId       String?
  worker         User?         @relation("WorkerAssignments", fields: [workerId], references: [id], onDelete: SetNull)

  assignedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([trackingNumber])
  @@index([workerId])
  @@index([customerId])
  @@map("service_enquiries")
}

