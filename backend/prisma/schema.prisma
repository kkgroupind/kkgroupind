// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  SUPER_ADMIN
  WORKER
  OFFICE_STAFF
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ServiceStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WorkerStatus {
  AVAILABLE
  BUSY
  OFF_DUTY
}

enum StaffStatus {
  AVAILABLE
  OFF_DUTY
}

enum AttendanceStatus {
  PRESENT
  LEAVE
  OFF_DUTY
}

model User {
  id              String            @id @default(uuid())
  name            String?
  email           String?           @unique
  username        String?           @unique
  phone           String?
  avatar          String?
  password        String
  role            Role              @default(CUSTOMER)
  workerStatus    WorkerStatus?     @default(AVAILABLE)
  staffStatus     StaffStatus?      @default(OFF_DUTY)
  isEmailVerified Boolean           @default(false)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  otps                Otp[]
  attendances         Attendance[]
  customerEnquiries   ServiceEnquiry[] @relation("CustomerEnquiries")
  officeEnquiries     ServiceEnquiry[] @relation("OfficeEnquiries")
  workerAssignments   ServiceEnquiry[] @relation("WorkerAssignments")
  createdEnquiries    ServiceEnquiry[] @relation("CreatedEnquiries")

  recordedFinances    FinancialTransaction[] @relation("RecordedFinances")
  verifiedFinances    FinancialTransaction[] @relation("VerifiedFinances")
  workerFinances      FinancialTransaction[] @relation("WorkerFinances")
  auditLogs           AuditLog[]             @relation("UserAuditLogs")
  notifications       Notification[]         @relation("UserNotifications")

  @@map("users")
}

model Attendance {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String           // YYYY-MM-DD
  status     AttendanceStatus @default(PRESENT)
  checkInAt  DateTime         @default(now())
  checkOutAt DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([userId])
  @@map("attendances")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  type      OtpType  @default(EMAIL_VERIFICATION)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, isUsed])
  @@map("otps")
}

model ServiceEnquiry {
  id                  String        @id @default(uuid())
  trackingNumber      String        @unique
  serviceName         String
  customerName        String
  customerEmail       String?
  customerPhone       String

  // Kerala Structured Location Details
  state               String        @default("Kerala")
  district            String        @default("Kasaragod")
  city                String?
  location            String?
  mapUrl              String?
  locationRemarks     String?

  // Schedule & Optional Deadline
  preferredDate       DateTime?
  deadline            DateTime?

  // Creator Attribution Flag
  createdByRole       Role          @default(CUSTOMER)
  createdById         String?
  creator             User?         @relation("CreatedEnquiries", fields: [createdById], references: [id], onDelete: SetNull)

  // Work Execution & Hourly Calculation (e.g. JCB / Equipment Meter)
  isHourlyCalculated  Boolean       @default(false)
  hourlyRate          Float?
  workStartedAt       DateTime?
  workEndedAt         DateTime?
  workDurationMinutes Int?
  workerAcceptance    String?

  // Unit-Based Service Specification & Wage Calculation System
  wageType             String?       // HOURLY, PER_TREE, PER_SQFT, PER_POINT, PER_FOOT, DAILY_WAGE, FIXED_VISIT, CUSTOM
  unitLabel            String?       // "Hour", "Tree", "Sq. Ft.", "Point", "Foot", "Day", "Visit"
  unitRate             Float?        // Customer billable rate per unit
  workerUnitWage       Float?        // Worker wage compensation rate per unit
  estimatedUnits       Float?        // Initial estimated units (e.g. 15 trees, 4 hours, 500 sqft)
  completedUnits       Float?        // Actual completed count/units logged by worker
  minUnits             Float?        @default(1)
  specificationDetails Json?         // Measurements, meter readings, tree specifics, notes
  totalCalculatedWage  Float?        // workerUnitWage * completedUnits
  totalCalculatedCost  Float?        // unitRate * completedUnits

  message             String
  status              ServiceStatus @default(PENDING)
  notes               String?

  customerId          String?
  customer            User?         @relation("CustomerEnquiries", fields: [customerId], references: [id], onDelete: SetNull)

  officeStaffId       String?
  officeStaff         User?         @relation("OfficeEnquiries", fields: [officeStaffId], references: [id], onDelete: SetNull)

  workerId            String?
  worker              User?         @relation("WorkerAssignments", fields: [workerId], references: [id], onDelete: SetNull)

  financialTransactions FinancialTransaction[]

  assignedAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([status])
  @@index([trackingNumber])
  @@index([workerId])
  @@index([customerId])
  @@index([district])
  @@index([createdByRole])
  @@map("service_enquiries")
}

model Service {
  id               String   @id @default(uuid())
  serviceId        String   @unique
  name             String
  slug             String   @unique
  category         String?  @default("General")
  description      String
  features         String[] @default([])
  icon             String?
  image            String?
  priceRange       String?
  duration         String?

  // Service Specification & Wage/Pricing Matrix
  wageType         String?  // HOURLY, PER_TREE, PER_SQFT, PER_POINT, PER_FOOT, DAILY_WAGE, FIXED_VISIT, CUSTOM
  unitLabel        String?  // "Hour", "Tree", "Sq. Ft.", "Point", "Foot", "Day", "Visit"
  baseCustomerRate Float?   // Default customer price per unit (e.g. ₹1500/hr, ₹120/tree)
  baseWorkerWage   Float?   // Default worker wage per unit (e.g. ₹800/hr, ₹80/tree)
  minUnits         Float?   @default(1)        // Minimum billable units (e.g. 2 hrs, 5 trees)
  specifications   Json?    // Detailed specification schema, equipment, checklists, safety requirements

  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([serviceId])
  @@index([isActive])
  @@index([category])
  @@index([wageType])
  @@map("services")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionCategory {
  // Income categories
  SERVICE_PAYMENT
  ADVANCE_PAYMENT
  MILESTONE_PAYMENT
  FINAL_SETTLEMENT

  // Expense categories
  FUEL_DIESEL
  WORKER_WAGE
  WORKER_BATA
  MATERIAL_PURCHASE
  EQUIPMENT_REPAIR
  OFFICE_EXPENSE
  TRANSPORT_TRAVEL
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
}

enum FinancialStatus {
  PENDING
  VERIFIED
  REJECTED
}

model FinancialTransaction {
  id                String              @id @default(uuid())
  transactionNumber String              @unique
  type              TransactionType
  category          TransactionCategory
  amount            Float
  date              DateTime
  dateString        String              // YYYY-MM-DD
  paymentMethod     PaymentMethod       @default(CASH)
  status            FinancialStatus     @default(PENDING)
  referenceNumber   String?
  serviceType       String?
  customerName      String?
  vendorName        String?
  notes             String?
  receiptUrl        String?

  enquiryId         String?
  enquiry           ServiceEnquiry?     @relation(fields: [enquiryId], references: [id], onDelete: SetNull)

  workerId          String?
  worker            User?               @relation("WorkerFinances", fields: [workerId], references: [id], onDelete: SetNull)

  recordedById      String
  recordedBy        User                @relation("RecordedFinances", fields: [recordedById], references: [id], onDelete: Cascade)

  verifiedById      String?
  verifiedBy        User?               @relation("VerifiedFinances", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([dateString])
  @@index([type])
  @@index([status])
  @@index([category])
  @@index([recordedById])
  @@index([enquiryId])
  @@map("financial_transactions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)
  userName   String?
  userEmail  String?
  userRole   Role?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  URGENT
  ENQUIRY
  ASSIGNMENT
  DUTY
  FINANCE
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  link      String?
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model SiteSetting {
  id                  String   @id @default("default")
  siteName            String   @default("KK Group")
  siteTagline         String   @default("Professional Services & Workforce Solutions")
  siteTaglineMl       String?  @default("കാസർഗോഡ് ജില്ലയിലെ വിശ്വസനീയമായ തൊഴിൽ സേവനങ്ങൾ")
  primaryDistrict     String   @default("Kasaragod")
  operatingAreas      String   @default("Kasaragod, Kanhangad, Nileshwaram, Uppala, Manjeshwar, Cheruvathur, Bekal, Kumbla")
  contactPhone        String   @default("+91 94470 12345")
  whatsappPhone       String   @default("+91 98460 54321")
  supportEmail        String   @default("contact@kkgroupkerala.com")
  officeAddress       String   @default("KK Group Hub, Main Road, Kasaragod, Kerala - 671121")
  businessHours       String   @default("08:00 AM - 07:00 PM (Monday - Saturday)")
  emergencyDispatch   Boolean  @default(true)
  publicEnquiries     Boolean  @default(true)
  multilingualEnabled Boolean  @default(true)
  announcementBanner  String?  @default("Special seasonal offers available on coconut tree maintenance and cleaning across Kasaragod.")
  bannerActive        Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  updatedBy           String?

  @@map("site_settings")
}

