# ==============================================================================
# KK Group Frontend Environment Variables Template
# ==============================================================================

# Backend API Base URL
# - Local Backend: http://localhost:5000/api
# - AWS EC2 Direct: http://<YOUR_EC2_PUBLIC_IP>:5000/api
# - Production Domain: https://api.kkgroup.in/api

NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Cloudinary
CLOUDINARY_APP_NAME=your-app-name
CLOUDINARY_KEY_NAME=your-key-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-upload-preset
