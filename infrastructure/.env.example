# ==============================================================================
# Production Environment Variables for KK Group Backend on AWS EC2
# ==============================================================================

NODE_ENV=production
PORT=5000

# PostgreSQL Connection (Neon or AWS RDS)
# Ensure your Neon project is in the same AWS region as your EC2 instance (e.g. ap-south-1)
DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.ap-south-1.aws.neon.tech/kkgroup?sslmode=require

# CORS Allowed Origin (e.g., your Vercel frontend or production domain)
CORS_ORIGIN=https://kkgroup.com,https://admin.kkgroup.com

# JWT Configuration (Must be a secure random 32+ character string)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials (Optional overrides)
SUPER_ADMIN_EMAIL=admin@kkgroup.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=YourStrongPassword#2026

# Email / SMTP Configuration
APP_EMAIL=
APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KK Group" <noreply@kkgroup.com>
